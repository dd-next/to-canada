[
 {
  "id": "language-life",
  "topic": "language_life",
  "title": "Language and daily life: French reach, commutes and household size",
  "question": "Which official language will I need day to day, and how do people get around?",
  "dek": "2021 Census figures for each place's metropolitan area or agglomeration show where French is the working language, where both languages are common, and how commuting differs.",
  "findings": [
   {
    "id": "french-knowledge",
    "kind": "calculation",
    "headline": "French is nearly universal in 4 Quebec places (90–99%), but only 41–65% of residents also speak English",
    "detail": "Share of residents who can conduct a conversation in French: Montréal 90%, Gatineau 91%, Québec City 99%, Sherbrooke 98%. Share who know both official languages is lower: Québec City 41% to Gatineau 65% (the Quebec part of Ottawa–Gatineau is the most bilingual of the Quebec places).",
    "stat": {
     "value": 41.5,
     "unit": "percent",
     "label": "Québec City: knows English and French",
     "period": "2021"
    },
    "placeIds": [
     "montreal",
     "gatineau",
     "quebec-city",
     "sherbrooke"
    ],
    "metricId": "lang_bilingual",
    "sourceIds": [
     "statcan-98-10-0175-01"
    ],
    "calc": "lang_bilingual = 'English and French' / total population in private households (98-10-0175-01, total mother tongue, total age and gender); lang_french_knowledge = ('French only' + 'English and French') / total."
   },
   {
    "id": "bilingual-outside-quebec",
    "kind": "calculation",
    "headline": "Outside Quebec, Moncton (46%), Greater Sudbury (37%) and Ottawa (36%) have the most bilingual residents; the lowest is Abbotsford–Mission at 4%",
    "detail": "Median share knowing both official languages across the 26 places outside Quebec is 8.1%. Ottawa (Ontario part) is 36% and Gatineau (Quebec part) 65% - the two parts of one CMA differ sharply. French knowledge here is self-reported conversational ability for all ages, including children in French-immersion schooling.",
    "placeIds": [
     "moncton",
     "sudbury",
     "ottawa",
     "ottawa",
     "gatineau"
    ],
    "metricId": "lang_french_knowledge",
    "sourceIds": [
     "statcan-98-10-0175-01"
    ],
    "calc": "Same as above, restricted to places whose province is not QC; ranked descending on lang_bilingual."
   },
   {
    "id": "commute-modes",
    "kind": "calculation",
    "headline": "Transit carries 15–16% of commuters in Toronto, Montréal and Vancouver; no other place exceeds 10%, and cars carry 73–93% of commuters across the 30 places",
    "detail": "Among workers with a usual place of work in May 2021 (pandemic conditions), car/truck/van was the main mode for 73% in Yellowknife up to 93% in Windsor. Walking or cycling peaks in Yellowknife (20%), Victoria (15%) and Whitehorse (9%). Toronto has the largest share of commutes of 45 minutes or more (22%), then Abbotsford–Mission (19%) and Vancouver (18%).",
    "stat": {
     "value": 15.6,
     "unit": "percent",
     "label": "Toronto: commute mainly by transit",
     "period": "2021"
    },
    "placeIds": [
     "toronto",
     "montreal",
     "vancouver",
     "yellowknife",
     "toronto"
    ],
    "metricId": "commute_transit_share",
    "sourceIds": [
     "statcan-98-10-0457-01"
    ],
    "calc": "Shares = main-mode count / total commuters with a usual place of work (98-10-0457-01; total time leaving, age, gender; statistic Count). Active = walked + bicycle. 45+ min = (45 to 59 + 60 minutes and over) / total."
   },
   {
    "id": "household-size",
    "kind": "calculation",
    "headline": "Average household size ranges from 2.1 persons (Sherbrooke) to 2.8 (Abbotsford–Mission)",
    "detail": "Larger households cluster in Abbotsford–Mission, Toronto and Yellowknife (population in private dwellings divided by occupied private dwellings, 2021). Household size is a context measure for space and rent-sharing, not a quality ranking.",
    "placeIds": [
     "abbotsford-mission",
     "toronto",
     "yellowknife",
     "sherbrooke"
    ],
    "metricId": "hh_avg_size",
    "sourceIds": [
     "statcan-98-10-0038-01"
    ],
    "calc": "hh_avg_size = population in private dwellings / private dwellings occupied by usual residents (98-10-0038-01), CMA/CA or CMA part."
   }
